# Fallback for agents without an llm value in agents.yaml.
LLM_PROVIDER=gemini
LLM_MODEL=gemini/gemini-3.5-flash-lite

# Optional per-agent provider overrides. The YAML llm entry is used by default.
ENGINEERING_LEAD_PROVIDER=openai
BACKEND_ENGINEER_PROVIDER=openai
FRONTEND_ENGINEER_PROVIDER=gemini
TEST_ENGINEER_PROVIDER=gemini

# Add both keys; each agent reads the key matching its selected provider.
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Optional global key for the provider in LLM_PROVIDER.
# LLM_API_KEY=

# Optional per-agent model/key overrides, for example:
# BACKEND_ENGINEER_MODEL=openai/gpt-4o-mini
# BACKEND_ENGINEER_API_KEY=your-openai-api-key-here

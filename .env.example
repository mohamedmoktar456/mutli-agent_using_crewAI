# Fallback for agents without an llm value in agents.yaml.
LLM_PROVIDER=gemini
LLM_MODEL=gemini/gemini-3.5-flash-lite

# Free-tier Gemini model configured for every agent in agents.yaml.
# Free usage has model and project quota limits.
ENGINEERING_LEAD_PROVIDER=gemini
BACKEND_ENGINEER_PROVIDER=gemini
FRONTEND_ENGINEER_PROVIDER=gemini
TEST_ENGINEER_PROVIDER=gemini

# Required for the selected Gemini model. GOOGLE_API_KEY also works.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional if you later switch an agent to OpenAI (API credits may be required).
OPENAI_API_KEY=your-openai-api-key-here

# Optional global key for the provider in LLM_PROVIDER.
# LLM_API_KEY=

# Optional per-agent model/key overrides can be set with <AGENT>_MODEL and <AGENT>_API_KEY.

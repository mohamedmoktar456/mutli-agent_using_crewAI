# Add the keys for providers used in delivery_team/crew_config/agents.yaml.
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: use a separate credential for a particular agent.
# ENGINEERING_LEAD_API_KEY=your-api-key-here
# BACKEND_ENGINEER_API_KEY=your-api-key-here
# FRONTEND_ENGINEER_API_KEY=your-api-key-here
# TEST_ENGINEER_API_KEY=your-api-key-here

# GOOGLE_API_KEY is also accepted as a Gemini key.
# GOOGLE_API_KEY=your-gemini-api-key-here

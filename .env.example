# Copy this file to .env and add your provider API key.
# Supported: openai, gemini, anthropic, ollama, openrouter
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-api-key-here

# Optional: provider-specific environment key (used if LLM_API_KEY is empty)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# Optional custom endpoint (useful for compatible APIs or local Ollama)
# LLM_BASE_URL=http://localhost:11434
